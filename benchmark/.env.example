# Copy this file to benchmark/.env (gitignored) and fill in values.
# Shell environment variables override these.

# --- Model under test (read by app.core.config) ---------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=300

# --- LLM judge ------------------------------------------------------------
# JUDGE_HOST defaults to OLLAMA_HOST.
# JUDGE_HOST=http://localhost:11434
JUDGE_MODEL=qwen3.5:4b
JUDGE_TIMEOUT_SECONDS=300
