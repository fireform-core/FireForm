# Copy this file to .env.dev and fill in values.

# --- App ------------------------------------------------------------------
APP_PORT=8000

# --- Database -------------------------------------------------------------
# Dev: postgres runs inside Docker Compose, no config needed.
DATABASE_URL=postgresql+psycopg2://fireform:fireform@localhost:5432/fireform
# Prod with docker/prod/compose.postgres.yml: set a password and use the service name.
#   POSTGRES_PASSWORD=<password>
#   DATABASE_URL=postgresql+psycopg2://fireform:<password>@postgres:5432/fireform

# --- Ollama ---------------------------------------------------------------
# Bundled (default): Ollama runs in the Docker stack       -> make fireform
#   OLLAMA_HOST=http://ollama:11434
# On the host (Metal/GPU on Mac), no model download in Docker -> make fireform-native
#   OLLAMA_HOST=http://host.docker.internal:11434
# A remote Ollama server (e.g. a GPU box), no download       -> make fireform-native
#   OLLAMA_HOST=http://<server>:11434
# With fireform-native the model must already be pulled where Ollama runs.
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=300

# --- LLM provider ---------------------------------------------------------
# Ollama (above) is the default. To use something else, set LLM_PROVIDER:
#   openai     needs LLM_MODEL and OPENAI_API_KEY
#   gemini     needs LLM_MODEL and GEMINI_API_KEY
#   anthropic  needs LLM_MODEL and ANTHROPIC_API_KEY
#   custom     any OpenAI compatible server (vLLM, LM Studio, llama.cpp, Groq,
#              OpenRouter), needs LLM_BASE_URL and LLM_MODEL. LLM_API_KEY
#              only if the server wants one.
# Examples:
#   LLM_PROVIDER=custom  LLM_BASE_URL=http://vllm:8000/v1  LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#   LLM_PROVIDER=openai  LLM_MODEL=gpt-4.1-mini  OPENAI_API_KEY=sk-...  LLM_ALLOW_EXTERNAL=true
LLM_PROVIDER=ollama
# Overrides the provider's default URL. For ollama it overrides OLLAMA_HOST.
LLM_BASE_URL=
# Keys for each hosted provider, so several can sit here and LLM_PROVIDER
# picks. LLM_API_KEY is for custom, and a fallback for the others.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_API_KEY=
# For ollama, empty falls back to OLLAMA_MODEL.
LLM_MODEL=
# Incident text holds names, addresses and medical detail. A server outside
# localhost or a private network is refused unless this is true.
LLM_ALLOW_EXTERNAL=false
# Seconds per fill. Empty falls back to OLLAMA_TIMEOUT.
LLM_TIMEOUT=
# Retries on rate limits (429) and server errors (5xx). Default 3.
LLM_MAX_RETRIES=
# Send the form's JSON schema as response_format. Empty uses the provider
# default (on for all but anthropic). Turn off for servers that reject it.
LLM_STRUCTURED_OUTPUT=
# Output token cap. Empty sends none (anthropic defaults to 12288).
LLM_MAX_TOKENS=
# Empty sends none. Some models (OpenAI reasoning models) reject temperature.
LLM_TEMPERATURE=0

# --- Whisper --------------------------------------------------------------
# Whisper runs in Docker with port mapped to host. App runs on host.
# Override to point at an external Whisper endpoint.
WHISPER_HOST=http://whisper:9000
WHISPER_MODEL=small.en

# --- Celery / Redis -------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- App workers (prod only, uvicorn WEB_CONCURRENCY) --------------------
GUNICORN_WORKERS=2

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
