# Copy this file to .env.dev and fill in values.

# --- App ------------------------------------------------------------------
APP_PORT=8000

# --- Database -------------------------------------------------------------
# Dev: postgres runs inside Docker Compose, no config needed.
DATABASE_URL=postgresql+psycopg2://fireform:fireform@localhost:5432/fireform
# Prod with docker/prod/compose.postgres.yml: set a password and use the service name.
#   POSTGRES_PASSWORD=<password>
#   DATABASE_URL=postgresql+psycopg2://fireform:<password>@postgres:5432/fireform

# --- LLM providers --------------------------------------------------------
# Several providers can be on at once, and each fill picks one. A provider is
# on when its <PROVIDER>_MODELS is not empty. GET /api/v1/system/llm/models
# lists what can be picked, POST /api/v1/system/llm/test checks a model answers.
#
# <PROVIDER>_MODELS is either * or a comma separated list:
#   *      every model the provider lists, including ones that can't fill forms
#          (OpenAI lists embedding, image and speech models too)
#   a,b,c  only these. Names the provider doesn't offer are logged as a
#          warning at startup and left out of the list.
#
# The default is used when a fill names no provider or model. If the default
# provider's settings are wrong the app won't start. Any other provider with
# wrong settings is turned off with a warning in the log.
LLM_PROVIDER=ollama
# Empty uses OLLAMA_MODEL for ollama, or the first name in <PROVIDER>_MODELS.
LLM_MODEL=

# Incident text holds names, addresses and medical detail. A provider outside
# localhost or a private network stays off unless this is true. That covers
# openai, gemini and anthropic.
LLM_ALLOW_EXTERNAL=false
# Seconds per fill. Empty falls back to OLLAMA_TIMEOUT.
LLM_TIMEOUT=
# Retries on rate limits (429) and server errors (5xx). Default 3.
LLM_MAX_RETRIES=
# Empty sends none. Some models (OpenAI reasoning models) reject temperature.
LLM_TEMPERATURE=0

# Optional master key override. If unset, the API generates a key on first save
# in the persistent API/worker volume; LLM_SECRET_KEY takes precedence if set.
# Back up that generated key. Removing Compose volumes removes it and saved
# provider credentials must be entered again.
# LLM_SECRET_KEY=
# Optional key-file path override (default: /data/secrets/llm_secret.key in Docker).
# LLM_SECRET_KEY_FILE=/data/secrets/llm_secret.key

# Ollama
# Bundled (default): Ollama runs in the Docker stack       -> make fireform
#   OLLAMA_HOST=http://ollama:11434
# On the host (Metal/GPU on Mac), no model download in Docker -> make fireform-native
#   OLLAMA_HOST=http://host.docker.internal:11434
# A remote Ollama server (e.g. a GPU box), no download       -> make fireform-native
#   OLLAMA_HOST=http://<server>:11434
# With fireform-native the model must already be pulled where Ollama runs.
OLLAMA_HOST=http://ollama:11434
# Every pulled model by default. Empty turns Ollama off.
OLLAMA_MODELS=*
# Ollama's default model, and the one make fireform pulls.
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=300
# Seconds to wait without receiving any progress from Ollama before a model
# download via POST /system/llm/pull is aborted. Not a limit on the total
# download time (connecting is limited to 10 s). Default 120.
OLLAMA_PULL_TIMEOUT=120
# Models that can be downloaded when OLLAMA_MODELS=*. If empty, defaults to
# qwen2.5:1.5b,qwen2.5:3b,qwen2.5:7b,llama3.2:3b.
OLLAMA_INSTALLABLE_MODELS=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODELS=
# Optional: OPENAI_BASE_URL, OPENAI_MAX_TOKENS, OPENAI_STRUCTURED_OUTPUT

# Gemini
GEMINI_API_KEY=
GEMINI_MODELS=
# Optional: GEMINI_BASE_URL, GEMINI_MAX_TOKENS, GEMINI_STRUCTURED_OUTPUT

# Anthropic. Sends no schema and caps output at 12288 tokens unless told otherwise.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=
# Optional: ANTHROPIC_BASE_URL, ANTHROPIC_MAX_TOKENS, ANTHROPIC_STRUCTURED_OUTPUT

# Custom: any OpenAI compatible server (vLLM, LM Studio, llama.cpp, Groq,
# OpenRouter). Needs a base URL. The key only if the server wants one.
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODELS=
# Optional: CUSTOM_MAX_TOKENS, CUSTOM_STRUCTURED_OUTPUT

# The optional ones, for any provider:
#   <PROVIDER>_BASE_URL           overrides the provider's address
#   <PROVIDER>_MAX_TOKENS         output token cap. Empty sends none.
#   <PROVIDER>_STRUCTURED_OUTPUT  send the form's JSON schema as response_format.
#                                 Turn off for servers that reject it.
#
# Example, Ollama as default plus two Gemini models:
#   LLM_PROVIDER=ollama  LLM_ALLOW_EXTERNAL=true
#   GEMINI_API_KEY=...   GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro

# --- Whisper --------------------------------------------------------------
# Whisper runs in Docker with port mapped to host. App runs on host.
# Override to point at an external Whisper endpoint.
WHISPER_HOST=http://whisper:9000
WHISPER_MODEL=small.en

# --- Celery / Redis -------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- App workers (prod only, uvicorn WEB_CONCURRENCY) --------------------
GUNICORN_WORKERS=2

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
